# =====================================================================
# Mapa: casos por 10 mil hab. por bairro de Curitiba
# =====================================================================
library(readr); library(dplyr); library(sf); library(geobr)
library(ggplot2); library(scales); library(showtext); library(stringi)
library(stringr); library(purrr)
sysfonts::font_add_google("Space Mono", "mono2")
showtext_auto(); showtext_opts(dpi = 300)
arquivo      <- "2026-09-02_Casos_Dengue_Base_de_Dados.csv"
cache_mapa   <- "bairros_curitiba_geobr.rds"
cod_curitiba <- 4106902
data_corte   <- as.Date("2025-01-01")
inc_max      <- 90
pop_minima   <- 10
cor_tinta <- "#1B1B1B"; cor_cinza <- "#8C8C8C"; cor_nota <- "#2A2620"
ramp_cont <- colour_ramp(c("#F4BE7E","#F09A5A","#E8412F","#B83E20","#540D05"))
pt2mm <- function(pt) pt / ggplot2::.pt
num0  <- function(x) number(x, accuracy = 1, big.mark = ".", decimal.mark = ",")
limpa <- function(x) str_squish(toupper(stri_trans_general(x, "Latin-ASCII")))
chave <- function(x) limpa(str_remove(x, "\\s*\\(.*\\)\\s*$"))
anes <- function(s) map_dfr(seq_len(nrow(s)), function(i) {
co <- st_coordinates(s[i, ]); cn <- colnames(co)
L2 <- if ("L2" %in% cn) co[,"L2"] else 1
L3 <- if ("L3" %in% cn) co[,"L3"] else 1
data.frame(x = co[,"X"], y = co[,"Y"], feat = i, ring = co[,"L1"],
poly = paste(i, L2, L3, sep = "_")) })
resolve <- function(chaves, alvo, cand) {
out <- setNames(rep(NA_character_, length(chaves)), chaves)
for (k in chaves) {
if (k %in% alvo) { out[k] <- k; next }
c2 <- cand[[k]]; ok <- c2[c2 %in% alvo]
if (length(ok) > 0) { out[k] <- ok[1]; next }
d <- adist(k, alvo)[1, ] / pmax(nchar(k), nchar(alvo))
if (min(d) <= 0.2) out[k] <- alvo[which.min(d)] }
out }
casos <- read_delim(arquivo, ";") |>
transmute(dt = as.Date(`DATA DA NOTIFICAÇÃO`, "%d/%m/%Y"),
bk = chave(`BAIRRO DE RESIDÊNCIA`)) |>
filter(!is.na(dt), dt >= data_corte, bk != "") |> count(bk, name = "n")
# =====================================================================
# Barras semanais: casos por semana (data dos primeiros sintomas)
# =====================================================================
library(readr); library(dplyr); library(ggplot2)
library(lubridate); library(showtext)
sysfonts::font_add_google("Space Mono", "mono2")
showtext_auto(); showtext_opts(dpi = 300)
sem <- read_delim("2026-09-02_Casos_Dengue_Base_de_Dados.csv", ";") |>
transmute(dt = as.Date(`DATA DOS PRIMEIROS SINTOMAS`, "%d/%m/%Y")) |>
filter(dt >= "2025-01-01") |>
count(semana = floor_date(dt, "week", week_start = 7))
pico <- slice_max(sem, n, n = 1, with_ties = FALSE)
ggplot(sem, aes(semana, n)) +
geom_col(fill = "#E8412F", alpha = 0.9, width = 6) +
geom_col(data = pico, fill = "#8E1B10", width = 6) +
annotate("text", x = pico$semana, y = pico$n,
label = pico$n, vjust = -0.5, hjust = 0.5,
family = "mono2", fontface = "bold", color = "#8E1B10", size = 3.5) +
annotate("text", x = pico$semana, y = pico$n,
label = paste0("semana de ", format(pico$semana, "%d/%m")),
vjust = -0.5, hjust = -0.1,
family = "mono2", color = "#8E1B10", size = 3) +
scale_x_date(date_labels = "%b/%y", date_breaks = "4 months") +
scale_y_continuous(expand = expansion(mult = c(0, 0.12))) +
theme_minimal(base_family = "mono2") +
theme(panel.grid.major.x = element_blank(),
panel.grid.minor   = element_blank(),
panel.grid.major.y = element_line(linetype = "dotted",
color = "#1B1B1B", linewidth = 0.25),
axis.title = element_blank(),
axis.text  = element_text(color = "#1B1B1B"))
# =====================================================================
# Pirâmide etária por sexo
# =====================================================================
library(readr); library(dplyr); library(ggplot2); library(showtext)
sysfonts::font_add_google("Space Mono", "mono2")
sysfonts::font_add_google("Anton", "anton")
showtext_auto(); showtext_opts(dpi = 300)
p <- read_delim("2026-09-02_Casos_Dengue_Base_de_Dados.csv", ";") |>
transmute(dt    = as.Date(`DATA DA NOTIFICAÇÃO`, "%d/%m/%Y"),
sexo  = `SEXO`,
idade = as.numeric(`IDADE (anos)`)) |>
filter(dt >= "2025-01-01", !is.na(idade), idade >= 0, idade <= 110) |>
mutate(faixa = cut(idade, c(0,10,20,30,40,50,60,Inf), right = FALSE,
labels = c("0 a 9","10 a 19","20 a 29","30 a 39",
"40 a 49","50 a 59","60+"))) |>
summarise(F = sum(sexo == "F"), M = sum(sexo == "M"), .by = faixa) |>
arrange(faixa) |>
mutate(i = row_number())
pf  <- sum(p$F) / (sum(p$F) + sum(p$M))
u   <- max(p$F, p$M)
gap <- 0.32 * u; off <- 0.04 * u; mb <- 0.46
mm  <- function(x) x / ggplot2::.pt
pct <- sub("\\.", ",", sprintf("%.1f%%", c(pf, 1 - pf) * 100))
ggplot() +
annotate("rect", xmin = -(gap + p$F), xmax = -gap,
ymin = p$i - mb, ymax = p$i + mb, fill = "#D9778F") +
annotate("rect", xmin = gap, xmax = gap + p$M,
ymin = p$i - mb, ymax = p$i + mb, fill = "#5B86B0") +
annotate("text", x = -(gap + p$F) - off, y = p$i, label = p$F, hjust = 1,
family = "mono2", fontface = "bold", size = mm(9)) +
annotate("text", x =  gap + p$M + off, y = p$i, label = p$M, hjust = 0,
family = "mono2", fontface = "bold", size = mm(9)) +
annotate("text", x = 0, y = p$i, label = p$faixa,
family = "mono2", fontface = "bold", size = mm(9.5)) +
annotate("text", x = c(-gap, gap), y = 8.80, label = c("MULHERES","HOMENS"),
hjust = c(1, 0), family = "mono2", fontface = "bold",
size = mm(8), color = c("#B8486A", "#2F5C85")) +
annotate("text", x = c(-gap, gap), y = 8.10, label = pct,
hjust = c(1, 0), family = "anton",
size = mm(18), color = c("#B8486A", "#2F5C85")) +
scale_x_continuous(limits = c(-1.65 * u, 1.65 * u), expand = c(0, 0)) +
scale_y_continuous(limits = c(0.10, 9.10), expand = c(0, 0)) +
theme_void()
# =====================================================================
# Waffle: origem de infecção (1 quadrado = 1%)
# =====================================================================
library(readr); library(dplyr); library(ggplot2); library(showtext)
sysfonts::font_add_google("Space Mono", "mono2")
showtext_auto(); showtext_opts(dpi = 300)
d <- read_delim("2026-09-02_Casos_Dengue_Base_de_Dados.csv", ";") |>
transmute(dt   = as.Date(`DATA DA NOTIFICAÇÃO`, "%d/%m/%Y"),
tipo = `LOCAL DE INFECÇÃO`) |>
filter(!is.na(dt), dt >= "2025-01-01",
tipo %in% c("Autóctone", "Importado")) |>
count(tipo)
pct_auto <- round(100 * d$n[d$tipo == "Autóctone"] / sum(d$n))
cel <- tibble(k = 0:99, row = k %/% 10, col = k %% 10, aut = k < pct_auto)
ggplot(cel, aes(col, row, fill = aut)) +
geom_tile(width = 0.86, height = 0.86) +
scale_fill_manual(
values = c(`TRUE` = "#E8412F", `FALSE` = "#8C8C8C"),
breaks = c(TRUE, FALSE),
labels = c(paste0(pct_auto, "% AUTÓCTONES"),
paste0(100 - pct_auto, "% IMPORTADOS"))) +
coord_equal(expand = FALSE) +
theme_void(base_family = "mono2") +
theme(legend.position  = "top",
legend.direction = "vertical",
legend.title     = element_blank(),
legend.text      = element_text(face = "bold", size = 10))
